@{
    ViewData["Title"] = "Contact Us";
}

<h1>Contact Us</h1>
<p class="text-muted">Get in touch with the Gift of the Givers Foundation team.</p>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Address</dt>
            <dd class="col-sm-8">Gift of the Givers House, Sunningdale, Durban, South Africa</dd>

            <dt class="col-sm-4">Phone</dt>
            <dd class="col-sm-8">+27 800 786 911</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">info@giftofthegivers.org</dd>

            <dt class="col-sm-4">Office Hours</dt>
            <dd class="col-sm-8">Monday – Friday, 08:00 – 17:00 SAST</dd>
        </dl>
    </div>

    <div class="col-md-6">
        <h5>Send Us a Message</h5>
        <form>
            <div class="mb-3">
                <label class="form-label">Your Name</label>
                <input type="text" class="form-control" placeholder="Full name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Your Email</label>
                <input type="email" class="form-control" placeholder="name@example.com" />
            </div>
            <div class="mb-3">
                <label class="form-label">Message</label>
                <textarea class="form-control" rows="4" placeholder="How can we help?"></textarea>
            </div>
            <button type="button" class="btn btn-primary" disabled title="Not wired up yet — prototype placeholder">Send Message</button>
        </form>
        <p class="text-muted small mt-2">This form is a visual placeholder at prototype stage — no backend submission logic yet.</p>
    </div>
</div>