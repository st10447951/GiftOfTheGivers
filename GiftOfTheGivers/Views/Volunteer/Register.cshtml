@model VolunteerRegistrationViewModel
@{
    ViewData["Title"] = "Volunteer Registration";
}
<h2>Volunteer Registration</h2>
<div class="row">
    <div class="col-md-6">
        <form asp-controller="Volunteer" asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Skills" class="form-label">Skills (e.g. first aid, logistics, driving)</label>
                <input asp-for="Skills" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Availability" class="form-label">Availability (e.g. weekends, on-call)</label>
                <input asp-for="Availability" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" />
            </div>
            <button type="submit" class="btn btn-success">Save Volunteer Profile</button>
        </form>
    </div>
</div>
