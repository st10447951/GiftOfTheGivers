@using GiftOfTheGivers2.Models
@{
    ViewData["Title"] = "Employee Dashboard";
    var volunteers = ViewBag.Volunteers as List<Volunteer>;
    var donations = ViewBag.Donations as List<Donation>;
}

<h1>Employee Dashboard</h1>
<p class="text-muted">Overview of volunteer sign-ups and recent donations.</p>

<h3 class="mt-4">Volunteer Sign-Ups (@(volunteers?.Count ?? 0))</h3>
@if (volunteers == null || !volunteers.Any())
{
    <p>No volunteers have registered yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Skills</th>
                <th>Availability</th>
                <th>Registered</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in volunteers)
            {
                <tr>
                    <td>@v.FullName</td>
                    <td>@v.Email</td>
                    <td>@v.Skills</td>
                    <td>@v.Availability</td>
                    <td>@v.RegisteredDate.ToString("dd MMM yyyy, HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}

<h3 class="mt-5">Recent Donations (@(donations?.Count ?? 0))</h3>
@if (donations == null || !donations.Any())
{
    <p>No donations have been recorded yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Donor</th>
                <th>Amount</th>
                <th>Type</th>
                <th>Certificate No.</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in donations)
            {
                <tr>
                    <td>@(d.IsAnonymous ? "Anonymous" : d.DonorName)</td>
                    <td>@d.Amount.ToString("N2") @d.Currency</td>
                    <td>@d.DonationType</td>
                    <td>@d.CertificateNumber</td>
                    <td>@d.DonationDate.ToString("dd MMM yyyy, HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}