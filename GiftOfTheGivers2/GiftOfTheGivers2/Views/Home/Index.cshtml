@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="hero-banner mb-5">
    <img src="~/images/gotg-hero.png" alt="Gift of the Givers Foundation" class="hero-image" />
    <div class="hero-overlay">
        <h1 class="hero-title">Compassion in <span class="gold-accent">Action</span></h1>
        <p class="hero-subtitle">Coordinating relief, volunteers, and donations when it matters most.</p>
        <div class="hero-buttons">
            <a asp-controller="Donations" asp-action="Index" class="btn btn-lg btn-light me-3">Donate Now</a>
            <a asp-controller="Volunteers" asp-action="Register" class="btn btn-lg btn-outline-light">Become a Volunteer</a>
        </div>
    </div>
</div>

<!-- Blue Flexbox Feature Cards -->
<div class="feature-flex mb-5">
    <div class="feature-box">
        <div class="feature-icon"><i class="bi bi-heart-fill"></i></div>
        <h3>Make a Donation</h3>
        <p>Support relief efforts financially — one-time or recurring, in ZAR, USD, or EUR.</p>
        <a asp-controller="Donations" asp-action="Index" class="btn btn-light btn-sm">Donate</a>
    </div>
    <div class="feature-box">
        <div class="feature-icon"><i class="bi bi-people-fill"></i></div>
        <h3>Volunteer With Us</h3>
        <p>Offer your skills and availability to help coordinate disaster response on the ground.</p>
        <a asp-controller="Volunteers" asp-action="Register" class="btn btn-light btn-sm">Register</a>
    </div>
    <div class="feature-box">
        <div class="feature-icon"><i class="bi bi-info-circle-fill"></i></div>
        <h3>Our Mission</h3>
        <p>Learn more about how the Foundation has responded to crises across South Africa and beyond.</p>
        <a asp-controller="Home" asp-action="About" class="btn btn-light btn-sm">About Us</a>
    </div>
</div>

<!-- Impact Statement -->
<div class="impact-statement text-center mb-5">
    <p class="lead mb-0">
        The Gift of the Givers Foundation stands as a beacon of hope in times of crisis, dedicated to
        providing swift and effective aid to communities struck by natural disasters and emergencies.
    </p>
</div>