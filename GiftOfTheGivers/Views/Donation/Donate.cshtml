@model DonationViewModel
@{
    ViewData["Title"] = "Donate";
}
<h2>Donate to @Model.ProjectName</h2>
<div class="row">
    <div class="col-md-6">
        <form asp-controller="Donation" asp-action="Donate" method="post">
            <input type="hidden" asp-for="ProjectID" />
            <div asp-validation-summary="All" class="text-danger"></div>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <div class="mb-3">
                    <label asp-for="DonorName" class="form-label">Your name (for the tax certificate)</label>
                    <input asp-for="DonorName" class="form-control" />
                </div>
            }

            <div class="mb-3">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" class="form-control" type="number" step="0.01" />
            </div>
            <div class="mb-3">
                <label asp-for="Currency" class="form-label"></label>
                <select asp-for="Currency" class="form-select">
                    <option value="ZAR">ZAR (South African Rand)</option>
                    <option value="USD">USD (US Dollar)</option>
                    <option value="EUR">EUR (Euro)</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="DonationType" class="form-label">Donation frequency</label>
                <select asp-for="DonationType" class="form-select">
                    <option value="OneTime">One-time</option>
                    <option value="Recurring">Recurring (monthly)</option>
                </select>
            </div>
            <button type="submit" class="btn btn-warning">Confirm Donation</button>
        </form>
    </div>
</div>
