@model GiftOfTheGivers2.Models.Donation
@{
    ViewData["Title"] = "Donation Confirmation";
}

<h1 class="text-success">Thank You for Your Donation!</h1>

<div class="card mt-4" style="max-width: 600px;">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Placeholder Tax Certificate</h4>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Certificate No.</dt>
            <dd class="col-sm-8">@Model.CertificateNumber</dd>

            <dt class="col-sm-4">Donor</dt>
            <dd class="col-sm-8">@(Model.IsAnonymous ? "Anonymous Donor" : Model.DonorName)</dd>

            <dt class="col-sm-4">Amount</dt>
            <dd class="col-sm-8">@Model.Amount.ToString("N2") @Model.Currency</dd>

            <dt class="col-sm-4">Donation Type</dt>
            <dd class="col-sm-8">@Model.DonationType</dd>

            <dt class="col-sm-4">Date Issued</dt>
            <dd class="col-sm-8">@Model.DonationDate.ToString("dd MMM yyyy, HH:mm")</dd>
        </dl>
    </div>
    <div class="card-footer text-end">
        <button class="btn btn-outline-primary" onclick="window.print()">Download / Print Certificate</button>
    </div>
</div>

<p class="mt-3">
    <a asp-controller="Home" asp-action="Index">Return to Home</a>
</p>