@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<div class="d-flex flex-column">
    @if (SignInManager.IsSignedIn(User))
    {
        <span class="text-muted small mb-2">Hello, @User.Identity!.Name!</span>
        <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button id="logout" type="submit" class="btn btn-sm btn-outline-primary w-100">Logout</button>
        </form>
    }
    else
    {
        <a class="btn btn-sm btn-outline-primary w-100 mb-2" asp-area="Identity" asp-page="/Account/Register">Register</a>
        <a class="btn btn-sm btn-primary w-100" asp-area="Identity" asp-page="/Account/Login">Login</a>
    }
</div>