@model ReliefProject
@{
    ViewData["Title"] = "New Relief Project";
}
<h2>New Relief Project</h2>
<form asp-controller="Projects" asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="ProjectName" class="form-label"></label>
        <input asp-for="ProjectName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="TargetAmount" class="form-label"></label>
        <input asp-for="TargetAmount" class="form-control" type="number" step="0.01" />
    </div>
    <button type="submit" class="btn btn-success">Create Project</button>
</form>
