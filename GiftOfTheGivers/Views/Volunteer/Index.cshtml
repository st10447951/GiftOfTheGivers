@model List<Volunteer>
@{
    ViewData["Title"] = "Registered Volunteers";
}
<h2>Registered Volunteers</h2>
<table class="table table-striped">
    <thead>
        <tr><th>Name</th><th>Skills</th><th>Availability</th><th>City</th></tr>
    </thead>
    <tbody>
    @foreach (var v in Model)
    {
        <tr>
            <td>@v.User?.FullName</td>
            <td>@v.Skills</td>
            <td>@v.Availability</td>
            <td>@v.City</td>
        </tr>
    }
    </tbody>
</table>
