@model Donation
@{
    ViewData["Title"] = "Tax Certificate";
}
<div class="card p-4 shadow-sm" style="max-width:600px; border:2px solid #2E5E4E;">
    <h3 style="color:#2E5E4E;">Thank you for your donation!</h3>
    <hr />
    <h5>Section 18A Donation Tax Certificate (Placeholder)</h5>
    <p><strong>Certificate No:</strong> GOTG-@Model.DonationID.ToString("D6")</p>
    <p><strong>Donor:</strong> @Model.DonorName</p>
    <p><strong>Project:</strong> @Model.Project?.ProjectName</p>
    <p><strong>Amount:</strong> @Model.Amount.ToString("N2") @Model.Currency</p>
    <p><strong>Type:</strong> @Model.DonationType</p>
    <p><strong>Date:</strong> @Model.DonationDate.ToString("dd MMMM yyyy")</p>
    <p class="text-muted small mt-3">This is a placeholder certificate for prototype purposes. A downloadable PDF version is planned for Sprint 2.</p>
</div>
<a class="btn btn-outline-success mt-3" asp-controller="Home" asp-action="Index">Back to Home</a>
