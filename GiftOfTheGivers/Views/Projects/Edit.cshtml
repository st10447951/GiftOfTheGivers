@model ReliefProject
@{
    ViewData["Title"] = "Edit Relief Project";
}
<h2>Edit Relief Project</h2>
<form asp-controller="Projects" asp-action="Edit" asp-route-id="@Model.ProjectID" method="post">
    <input type="hidden" asp-for="ProjectID" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="ProjectName" class="form-label"></label>
        <input asp-for="ProjectName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select">
            <option value="Active">Active</option>
            <option value="Closed">Closed</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="TargetAmount" class="form-label"></label>
        <input asp-for="TargetAmount" class="form-control" type="number" step="0.01" />
    </div>
    <button type="submit" class="btn btn-success">Save Changes</button>
</form>
