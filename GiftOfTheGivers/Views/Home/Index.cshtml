@model List<ReliefProject>
@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 rounded-3" style="background-color:#EAF2EE;">
    <h1 class="display-6 fw-bold" style="color:#2E5E4E;">Gift of the Givers</h1>
    <p class="col-md-8 fs-5">Fast, transparent disaster relief &mdash; track exactly where your donation or your time goes, from flood relief to drought response.</p>
    <a class="btn btn-lg text-white" style="background-color:#8A6D00;" asp-controller="Account" asp-action="Register">Donate or Volunteer</a>
</div>

<h2 class="mb-3">Active Relief Projects</h2>
<div class="row">
    @foreach (var project in Model)
    {
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@project.ProjectName</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@project.Location</h6>
                    <p class="card-text">@project.Description</p>
                    <p class="text-muted small">Target: @project.TargetAmount.ToString("C")</p>
                    <a class="btn btn-outline-success" asp-controller="Projects" asp-action="Details" asp-route-id="@project.ProjectID">View Project</a>
                    <a class="btn btn-warning" asp-controller="Donation" asp-action="Donate" asp-route-projectId="@project.ProjectID">Donate</a>
                </div>
            </div>
        </div>
    }
</div>
